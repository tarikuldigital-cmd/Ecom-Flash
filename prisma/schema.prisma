generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
}
enum MemberRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  VIEWER
}
enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}
enum StoreStatus {
  ACTIVE
  INACTIVE
}
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StockMovementType {
  ADJUSTMENT
  RESTOCK
  SALE
  RETURN
  DAMAGE
  CORRECTION
}

enum CustomerSegment {
  NEW
  REGULAR
  VIP
}

enum CourierProvider {
  PATHAO
  STEADFAST
  REDX
  PAPERFLY
  ECOURIER
  OTHER
}

enum ShipmentStatus {
  DRAFT
  BOOKED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  DELIVERY_FAILED
  RETURNED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
  REFUNDED
}

enum PaymentMethod {
  COD
  CASH
  BANK_TRANSFER
  CARD
  MOBILE_BANKING
  OTHER
}

enum PaymentTransactionType {
  PAYMENT
  REFUND
}

model User {
  id              String       @id @default(cuid())
  name            String?
  email           String       @unique
  emailVerifiedAt DateTime?
  passwordHash    String
  isPlatformAdmin Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]
  sessions        Session[]
  auditEvents     AuditLog[]   @relation("AuditActor")
  stockMovements  InventoryMovement[] @relation("StockMovementActor")
  orderActivities OrderActivity[] @relation("OrderActivityActor")
  @@index([createdAt])
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  currency  String       @default("BDT")
  timezone  String       @default("Asia/Dhaka")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  members   Membership[]
  stores    Store[]
  auditLogs AuditLog[]
  categories Category[]
  products Product[]
  stockMovements InventoryMovement[]
  customers Customer[]
  orders Order[]
  orderItems OrderItem[]
  orderActivities OrderActivity[]
  courierAccounts CourierAccount[]
  deliveryRates DeliveryRate[]
  shipments Shipment[]
  shipmentEvents ShipmentEvent[]
  paymentTransactions PaymentTransaction[]
  invitations TeamInvitation[]
  landingPages LandingPage[]
  @@index([status, createdAt])
}

model Membership {
  id        String       @id @default(cuid())
  userId    String
  tenantId  String
  role      MemberRole   @default(STAFF)
  status    MemberStatus @default(ACTIVE)
  joinedAt  DateTime     @default(now())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([userId, tenantId])
  @@index([tenantId, role, status])
  @@index([userId, status])
}

model Store {
  id        String      @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  status    StoreStatus @default(ACTIVE)
  currency  String      @default("BDT")
  timezone  String      @default("Asia/Dhaka")
  tagline String?
  description String?
  logoUrl String?
  bannerUrl String?
  announcement String?
  primaryColor String @default("#193c2c")
  contactPhone String?
  contactEmail String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

model Category {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]
  @@unique([tenantId, slug])
  @@index([tenantId, name])
}

model Product {
  id             String        @id @default(cuid())
  tenantId       String
  categoryId     String?
  name           String
  slug           String
  sku            String?
  description    String?
  price          Decimal       @db.Decimal(12, 2)
  compareAtPrice Decimal?      @db.Decimal(12, 2)
  costPrice      Decimal?      @db.Decimal(12, 2)
  stockQuantity  Int           @default(0)
  status         ProductStatus @default(DRAFT)
  images         String[]      @default([])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockMovements InventoryMovement[]
  orderItems OrderItem[]
  @@unique([tenantId, slug])
  @@unique([tenantId, sku])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, categoryId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model InventoryMovement {
  id           String            @id @default(cuid())
  tenantId     String
  productId    String
  actorId      String?
  type         StockMovementType
  quantityDelta Int
  stockBefore  Int
  stockAfter   Int
  reason       String
  createdAt    DateTime          @default(now())
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  actor        User?             @relation("StockMovementActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([tenantId, createdAt])
  @@index([tenantId, productId, createdAt])
}

model Customer {
  id         String          @id @default(cuid())
  tenantId   String
  name       String
  phone      String?
  email      String?
  address    String?
  city       String?
  notes      String?
  segment    CustomerSegment @default(NEW)
  isArchived Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders     Order[]
  @@index([tenantId, name])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, segment, createdAt])
  @@index([tenantId, isArchived, createdAt])
}

model Order {
  id              String        @id @default(cuid())
  tenantId        String
  customerId      String?
  orderNumber     String
  trackingTokenHash String? @unique
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   PaymentMethod @default(COD)
  currency        String        @default("BDT")
  subtotal        Decimal       @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  shippingCharge  Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(12, 2)
  customerName    String
  customerPhone   String
  shippingAddress String
  shippingCity    String?
  customerNote    String?
  internalNote    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  activities      OrderActivity[]
  shipments       Shipment[]
  paymentTransactions PaymentTransaction[]
  @@unique([tenantId, orderNumber])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, paymentStatus, createdAt])
  @@index([tenantId, customerId, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  productId   String?
  productName String
  sku         String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([tenantId, orderId])
  @@index([tenantId, productId])
}

model OrderActivity {
  id        String   @id @default(cuid())
  tenantId  String
  orderId   String
  actorId   String?
  type      String
  title     String
  details   String?
  metadata  Json?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor     User?    @relation("OrderActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([tenantId, orderId, createdAt])
  @@index([actorId, createdAt])
}


model CourierAccount {
  id               String          @id @default(cuid())
  tenantId         String
  provider         CourierProvider
  displayName      String
  isEnabled        Boolean         @default(false)
  accountReference String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipments        Shipment[]
  @@unique([tenantId, provider])
  @@index([tenantId, isEnabled])
}

model Shipment {
  id                String          @id @default(cuid())
  tenantId          String
  orderId           String
  courierAccountId  String?
  provider          CourierProvider
  status            ShipmentStatus  @default(DRAFT)
  recipientName     String
  recipientPhone    String
  deliveryAddress   String
  deliveryCity      String?
  parcelDescription String?
  weightGrams       Int?
  codAmount         Decimal         @default(0) @db.Decimal(12, 2)
  deliveryCharge    Decimal         @default(0) @db.Decimal(12, 2)
  trackingNumber    String?
  consignmentId     String?
  bookingReference  String?
  trackingUrl       String?
  bookedAt          DateTime?
  deliveredAt       DateTime?
  lastSyncedAt      DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierAccount    CourierAccount? @relation(fields: [courierAccountId], references: [id], onDelete: SetNull)
  events            ShipmentEvent[]
  @@index([tenantId, status, createdAt])
  @@index([tenantId, orderId, createdAt])
  @@index([tenantId, trackingNumber])
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  tenantId   String
  shipmentId String
  actorId    String?
  status     ShipmentStatus
  title      String
  details    String?
  source     String         @default("MANUAL")
  createdAt  DateTime       @default(now())
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  @@index([tenantId, shipmentId, createdAt])
  @@index([actorId, createdAt])
}


model PaymentTransaction {
  id          String                 @id @default(cuid())
  tenantId    String
  orderId     String
  actorId     String?
  type        PaymentTransactionType @default(PAYMENT)
  amount      Decimal                @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  note        String?
  createdAt   DateTime               @default(now())
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
  @@index([tenantId, orderId, createdAt])
}


model TeamInvitation {
  id          String     @id @default(cuid())
  tenantId    String
  email       String
  role        MemberRole @default(STAFF)
  tokenHash   String     @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime   @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, email])
  @@index([tenantId, acceptedAt, expiresAt])
}


model LandingPage {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  slug        String
  status      String   @default("DRAFT")
  sections    Json
  seoTitle    String?
  seoDescription String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, slug])
  @@index([tenantId, status, updatedAt])
}


model DeliveryRate {
  id                    String   @id @default(cuid())
  tenantId              String
  zoneName              String
  city                  String
  charge                Decimal  @db.Decimal(12, 2)
  freeShippingMinimum   Decimal? @db.Decimal(12, 2)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, city])
  @@index([tenantId, isActive, city])
}
